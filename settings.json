{
    "settingGroups": {
        "FauxLiteDevice": {
            "description": "FauxLite Device",
            "level": 0,
            "settings": [
                "enabled",
                "host"
            ]
        },
        "FauxLiteNowPlaying": {
            "description": "Now Playing on the Sign",
            "level": 0,
            "settings": [
                "npEnabled",
                "npPage",
                "npFormat",
                "npFunction",
                "npColor",
                "npFont",
                "npSize"
            ]
        },
        "FauxLiteShowStopped": {
            "description": "When the Show Stops",
            "level": 0,
            "settings": [
                "stopAction",
