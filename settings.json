        "stopAction": {
            "name": "stopAction",
            "description": "Action",
            "tip": "What the sign does when a playlist stops (and when FPPD shuts down).",
            "restart": 0,
            "reboot": 0,
            "level": 0,
            "type": "select",
            "default": "keep",
            "options": {
                "Leave it as-is": "keep",
                "Blank the sign": "blank",
                "Show the time": "time",
                "Show the date": "date",
                "Show a custom message": "custom",
                "Start the device message queue": "queue"
            }
