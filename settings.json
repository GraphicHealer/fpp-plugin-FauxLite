                "stopText",
                "stopColor",
                "stopFunction"
            ]
        }
    },
    "settings": {
        "enabled": {
            "name": "enabled",
            "description": "Enabled",
            "tip": "Master switch. When off the plugin sends nothing at all.",
            "restart": 0,
            "reboot": 0,
            "level": 0,
            "type": "checkbox",
            "checkedValue": "1",
            "uncheckedValue": "0",
            "default": "0"
        },
        "host": {
            "name": "host",
            "description": "Device Address",
            "tip": "IP or mDNS name of the FauxLite bridge, e.g. 192.168.1.120 or faux-lite-AB12CD.local (port 80 is the default; add :port if changed).",
            "restart": 0,
            "reboot": 0,
            "level": 0,
            "type": "text",
            "size": 40,
            "maxlength": 128,
            "default": ""
        },
        "npEnabled": {
            "name": "npEnabled",
            "description": "Show Now Playing",
            "tip": "Updates the sign with the current song/sequence each time a media entry starts.",
            "restart": 0,
            "reboot": 0,
            "level": 0,
            "type": "checkbox",
            "checkedValue": "1",
            "uncheckedValue": "0",
            "default": "0"
        },
        "npPage": {
            "name": "npPage",
            "description": "Sign Page",
