{
    "settingGroups": {
        "FauxLiteDevice": {
            "description": "FauxLite Device",
            "level": 0,
            "settings": [
                "enabled",
                "host"
            ]
        },
        "FauxLiteNowPlaying": {
            "description": "Now Playing on the Sign",
            "level": 0,
            "settings": [
                "npEnabled",
                "npRestoreQueue"
            ]
        },
        "FauxLiteShowInfo": {
            "description": "Show Info (used by the {show*} placeholders)",
            "level": 0,
            "settings": [
                "showName",
                "showTagline",
                "showHost",
                "showLocation",
                "showSchedule",
                "showUrl"
            ]
        },
        "FauxLiteShowStopped": {
            "description": "When the Show Stops",
            "level": 0,
            "settings": [
                "stopAction",
                "stopPage",
                "stopText",
                "stopColor",
                "stopFunction"
            ]
        }
    },
    "settings": {
        "enabled": {
            "name": "enabled",
            "description": "Enabled",
            "tip": "Master switch. When off the plugin sends nothing at all.",
            "restart": 0,
            "reboot": 0,
            "level": 0,
            "type": "checkbox",
            "checkedValue": "1",
            "uncheckedValue": "0",
            "default": "0"
        },
        "host": {
            "name": "host",
            "description": "Device Address",
            "tip": "IP or mDNS name of the FauxLite bridge, e.g. 192.168.1.120 or faux-lite-AB12CD.local (port 80 is the default; add :port if changed).",
            "restart": 0,
            "reboot": 0,
            "level": 0,
            "type": "text",
            "size": 40,
            "maxlength": 128,
            "default": ""
        },
        "npEnabled": {
            "name": "npEnabled",
            "description": "Show Now Playing",
            "tip": "Updates the sign each time a media entry starts, using the Now Playing Pages list below. One page = a single display; two or more rotate via the device's message queue.",
            "restart": 0,
            "reboot": 0,
            "level": 0,
            "type": "checkbox",
            "checkedValue": "1",
            "uncheckedValue": "0",
            "default": "0"
        },
        "npRestoreQueue": {
            "name": "npRestoreQueue",
            "description": "Restore Device Queue on Stop",
            "tip": "Multi-page rotations borrow the device's message queue. When the show stops, the queue that was there before is put back (and restarted if it was running).",
            "restart": 0,
            "reboot": 0,
            "level": 0,
            "type": "checkbox",
            "checkedValue": "1",
            "uncheckedValue": "0",
            "default": "1"
        },
        "showName": {
            "name": "showName",
            "description": "Show Name",
            "tip": "Available in page text as {showName} — e.g. \"Jones Light Show\".",
            "restart": 0,
            "reboot": 0,
            "level": 0,
            "type": "text",
            "size": 40,
            "maxlength": 120,
            "default": ""
        },
        "showTagline": {
            "name": "showTagline",
            "description": "Tagline",
            "tip": "Available as {showTagline}.",
            "restart": 0,
            "reboot": 0,
            "level": 0,
            "type": "text",
            "size": 40,
            "maxlength": 120,
            "default": ""
        },
        "showHost": {
            "name": "showHost",
            "description": "Hosted By",
            "tip": "Available as {showHost}.",
            "restart": 0,
            "reboot": 0,
            "level": 0,
            "type": "text",
            "size": 40,
            "maxlength": 120,
            "default": ""
        },
        "showLocation": {
            "name": "showLocation",
            "description": "Location",
            "tip": "Available as {showLocation}.",
            "restart": 0,
            "reboot": 0,
            "level": 0,
            "type": "text",
            "size": 40,
            "maxlength": 120,
            "default": ""
        },
        "showSchedule": {
            "name": "showSchedule",
            "description": "Schedule",
            "tip": "Available as {showSchedule} — e.g. \"Nightly 6-10pm\".",
            "restart": 0,
            "reboot": 0,
            "level": 0,
            "type": "text",
            "size": 40,
            "maxlength": 120,
            "default": ""
