{ "name": "FauxLite - Countdown To Time",
  "description": "Count down to a show start on the sign. Programs the sign's countdown timer to the target time and writes a live countdown page (e.g. \"Show starts in 0:42:13\"); at zero the sign switches to the end page. {days} {hours} {minutes} {seconds} {target} {current} are live fields.",
  "script": "countdown.sh",
  "args": [
    { "name": "showTime", "type": "time", "description": "Show start time" },
    { "name": "date", "type": "string", "description": "Date (YYYY-MM-DD, blank = next occurrence)", "optional": true,
      "placeholder": "2026-12-24 or blank" },
    { "name": "format", "type": "string", "description": "Countdown text (blank = only program the timer)", "default": "Show starts in {hours}:{minutes}:{seconds}",
      "optional": true, "placeholder": "{hours}:{minutes}:{seconds} until showtime" },
    { "name": "page", "type": "string", "description": "Page for the countdown text", "default": "A",
      "contents": {"A": "A", "B": "B", "C": "C", "D": "D", "E": "E", "F": "F", "G": "G", "H": "H", "I": "I", "J": "J", "K": "K", "L": "L", "M": "M", "N": "N", "O": "O", "P": "P", "Q": "Q", "R": "R", "S": "S", "T": "T", "U": "U", "V": "V", "W": "W", "X": "X"} },
    { "name": "endPage", "type": "string", "description": "Page shown when the countdown reaches zero", "default": "A",
      "contents": {"A": "A", "B": "B", "C": "C", "D": "D", "E": "E", "F": "F", "G": "G", "H": "H", "I": "I", "J": "J", "K": "K", "L": "L", "M": "M", "N": "N", "O": "O", "P": "P", "Q": "Q", "R": "R", "S": "S", "T": "T", "U": "U", "V": "V", "W": "W", "X": "X"} },
    { "name": "color", "type": "string", "description": "Color", "default": "", "optional": true,
      "contents": {"Device default": "", "Dim red": "CA", "Red": "CB", "Bright red": "CC", "Orange": "CD", "Bright orange": "CE", "Light yellow": "CF", "Yellow": "CG", "Bright yellow": "CH", "Lime": "CI", "Dim lime": "CJ", "Bright lime": "CK", "Bright green": "CL", "Green": "CM", "Dim green": "CN", "Yellow/green/red": "CO", "Rainbow": "CP", "Red/green 3D": "CQ", "Red/yellow 3D": "CR", "Green/red 3D": "CS", "Green/yellow 3D": "CT", "Green on red": "CU", "Red on green": "CV", "Orange on green 3D": "CW", "Lime on red 3D": "CX", "Green on red 3D (alt)": "CY", "Red on green 3D (alt)": "CZ"} },
    { "name": "font", "type": "string", "description": "Font", "default": "", "optional": true,
      "contents": {"Device default": "", "Normal": "SA", "Bold": "SB", "Italic": "SC", "Bold italic": "SD", "Flash normal": "SE", "Flash bold": "SF", "Flash italic": "SG", "Flash bold italic": "SH"} },
    { "name": "size", "type": "string", "description": "Character size", "default": "", "optional": true,
      "contents": {"Device default": "", "5x7": "SI", "4x7 (smaller)": "SJ"} },
    { "name": "function", "type": "string", "description": "Display effect", "default": "", "optional": true,
      "contents": {"Device default": "", "Auto": "FA", "Open": "FB", "Cover": "FC", "Cycling": "FE", "Close right": "FF", "Close left": "FG", "Close both": "FH", "Scroll up": "FI", "Scroll down": "FJ", "Overlap": "FK", "Stacking": "FL", "Comic 1": "FM", "Comic 2": "FN", "Appear": "FQ", "Random": "FR", "Shift left": "FS", "Magic": "FU"} },
    { "name": "displayMode", "type": "string", "description": "After writing", "default": "display",
