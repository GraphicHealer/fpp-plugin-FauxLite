    { "name": "text", "type": "string", "description": "Message text",
      "placeholder": "Text to display briefly" },
    { "name": "repeat", "type": "int", "description": "Times to show it", "min": 1, "max": 99, "default": "1" },
    { "name": "color", "type": "string", "description": "Color", "default": "", "optional": true,
