{ "name": "FauxLite - Send Message",
  "description": "Write a text message to a sign page, optionally switching the display to that page.",
  "script": "send_message.sh",
  "args": [
    { "name": "message", "type": "string", "description": "Message text",
      "placeholder": "Text to display" },
    { "name": "page", "type": "string", "description": "Page (A-X; Y and Z are reserved for one-shot messages)", "default": "A",
      "contents": {"A": "A", "B": "B", "C": "C", "D": "D", "E": "E", "F": "F", "G": "G", "H": "H", "I": "I", "J": "J", "K": "K", "L": "L", "M": "M", "N": "N", "O": "O", "P": "P", "Q": "Q", "R": "R", "S": "S", "T": "T", "U": "U", "V": "V", "W": "W", "X": "X"} },
    { "name": "color", "type": "string", "description": "Color", "default": "", "optional": true,
      "contents": {"Device default": "", "Dim red": "CA", "Red": "CB", "Bright red": "CC", "Orange": "CD", "Bright orange": "CE", "Light yellow": "CF", "Yellow": "CG", "Bright yellow": "CH", "Lime": "CI", "Dim lime": "CJ", "Bright lime": "CK", "Bright green": "CL", "Green": "CM", "Dim green": "CN", "Yellow/green/red": "CO", "Rainbow": "CP", "Red/green 3D": "CQ", "Red/yellow 3D": "CR", "Green/red 3D": "CS", "Green/yellow 3D": "CT", "Green on red": "CU", "Red on green": "CV", "Orange on green 3D": "CW", "Lime on red 3D": "CX", "Green on red 3D (alt)": "CY", "Red on green 3D (alt)": "CZ"} },
    { "name": "font", "type": "string", "description": "Font", "default": "", "optional": true,
      "contents": {"Device default": "", "Normal": "SA", "Bold": "SB", "Italic": "SC", "Bold italic": "SD", "Flash normal": "SE", "Flash bold": "SF", "Flash italic": "SG", "Flash bold italic": "SH"} },
    { "name": "size", "type": "string", "description": "Character size", "default": "", "optional": true,
      "contents": {"Device default": "", "5x7": "SI", "4x7 (smaller)": "SJ"} },
    { "name": "function", "type": "string", "description": "Display effect", "default": "", "optional": true,
      "contents": {"Device default": "", "Auto": "FA", "Open": "FB", "Cover": "FC", "Date": "FD", "Cycling": "FE", "Close right": "FF", "Close left": "FG", "Close both": "FH", "Scroll up": "FI", "Scroll down": "FJ", "Overlap": "FK", "Stacking": "FL", "Comic 1": "FM", "Comic 2": "FN", "Beep": "FO", "Pause": "FP", "Appear": "FQ", "Random": "FR", "Shift left": "FS", "Time": "FT", "Magic": "FU", "Thank you": "FV", "Welcome": "FW"} },
